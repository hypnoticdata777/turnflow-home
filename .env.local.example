# Neon Postgres — Project → Connection Details → "Pooled connection"
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Vercel Blob — Project → Storage → your Blob store → .env.local tab
BLOB_READ_WRITE_TOKEN=

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Resend — resend.com/api-keys. Leave blank to log-only (no email sent);
# every attempt still records to the Notifications page either way.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=notifications@example.com

# Base URL used to build links in emails (accept-invite, etc.)
APP_URL=http://localhost:3000

# Shared secret checked against the Authorization header on
# /api/cron/reminder-digest — set the same value in the Vercel project's
# env vars once the cron job is deployed. Leave blank to allow
# unauthenticated access to that route locally.
CRON_SECRET=
