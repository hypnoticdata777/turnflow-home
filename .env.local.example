# Neon Postgres - Project > Connection Details > "Pooled connection"
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Vercel Blob - Project > Storage > your Blob store > .env.local tab
BLOB_READ_WRITE_TOKEN=
# Private is the default: leave this as "private" (or unset) when
# BLOB_READ_WRITE_TOKEN belongs to a Private store; files are then only readable
# through the authorized /api/files route. Set "public" ONLY for a legacy Public
# store on a local machine - `npm run poc:ready` blocks "public" on a hosted APP_URL,
# and any other value (e.g. a typo) is treated as "private".
BLOB_ACCESS=private

# Auth.js - generate with: openssl rand -base64 32
# In Vercel, set AUTH_SECRET and NEXTAUTH_SECRET to the same value.
AUTH_SECRET=
NEXTAUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Resend - resend.com/api-keys. Leave blank to log-only (no email sent);
# every attempt still records to the Notifications page either way.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=notifications@example.com

# Base URL used to build links in emails (accept-invite, etc.)
APP_URL=http://localhost:3000

# Shared secret checked against the Authorization header on
# /api/cron/reminder-digest - set the same value in the Vercel project's
# env vars once the cron job is deployed. Leave blank to allow
# unauthenticated access to that route locally (production refuses to run
# cron routes until it is set).
CRON_SECRET=

# Shared secret checked against the Authorization header on /api/health/deep.
# Keep this separate from CRON_SECRET so monitoring access can be rotated alone.
HEALTHCHECK_SECRET=

# Investor demo (optional). Shared password for the @turnflow.demo accounts;
# 12+ characters, never committed. Used by `npm run db:seed:investor` and the
# nightly /api/cron/reset-investor-demo job.
INVESTOR_DEMO_PASSWORD=
# Set to "true" only on the deployment that hosts the investor demo.
INVESTOR_DEMO_RESET_ENABLED=false

# Password for the `npm run db:seed` demo accounts. REQUIRED (12+ characters, not
# "password123") unless DATABASE_URL points at localhost - a hosted database such
# as Neon never gets the default demo password. When running the ux:* smoke
# scripts against the seeded accounts, set UX_OWNER_PASSWORD, UX_VENDOR_PASSWORD
# and UX_COLLABORATOR_PASSWORD to this same value.
SEED_PASSWORD=
