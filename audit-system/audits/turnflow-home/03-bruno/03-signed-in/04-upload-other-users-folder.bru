meta {
  name: Blob upload - another user's folder (403)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/blob-upload
  body: multipartForm
  auth: none
}

body:multipart-form {
  pathname: turnflow-property/00000000-0000-0000-0000-000000000000/11111111-1111-1111-1111-111111111111/pixel.png
  file: @file(fixtures/pixel.png)
}

assert {
  res.status: eq 403
  res.body.error: eq Not authorized to upload to this path
}
