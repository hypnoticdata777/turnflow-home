meta {
  name: Session - still anonymous after failed login
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/auth/session
  body: none
  auth: none
}

tests {
  test("no user in session", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body && res.body.user).to.equal(undefined);
  });
}
