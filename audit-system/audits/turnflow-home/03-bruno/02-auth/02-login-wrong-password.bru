meta {
  name: Login - wrong password gives no session (PROPOSED negative)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/callback/credentials
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  csrfToken: {{csrfToken}}
  email: {{ownerEmail}}
  password: definitely-not-the-password
  json: true
}

tests {
  test("sign-in is rejected", function () {
    const target = String((res.body && res.body.url) || res.getHeader("location") || "");
    expect(target).to.contain("error");
  });
}
